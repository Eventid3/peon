    {
      "id": "MKdxH7bFEDGYIfNPhlGmI",
      "type": "text",
      "x": 286.52734375,
      "y": 183.93359375,
      "width": 346.7846374511719,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
