      "seed": 1289234730,
      "version": 755,
      "versionNonce": 664669634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789315639237,
      "created": 1789314376435,
      "link": null,
      "locked": false,
      "text": "Types:\nBasic job interface\nJob interface {\n    Ecex(context) error\n}\n\nWrapper for Peon job registry\nJobRegistration {\n    name: string\n    job: Job\n    timing: time between execs\n}\n\nWrapper for worker input, so the worker \ncan report back what job is under execution\nWorkerJob {\n    name: string\n    job: Job\n}\n\nWrapper for worker response, so Peon knows\nwhat job has finished, and if it's successful\nWorkerResponse {\n    name: string\n    success: bool\n    err: error\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types:\nBasic job interface\nJob interface {\n    Ecex(context) error\n}\n\nWrapper for Peon job registry\nJobRegistration {\n    name: string\n    job: Job\n    timing: time between execs\n}\n\nWrapper for worker input, so the worker \ncan report back what job is under execution\nWorkerJob {\n    name: string\n    job: Job\n}\n\nWrapper for worker response, so Peon knows\nwhat job has finished, and if it's successful\nWorkerResponse {\n    name: string\n    success: bool\n    err: error\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
